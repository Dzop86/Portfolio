with "config/bataille_tests_config.gpr";
with "aunit.gpr";
with "bataille.gpr";

project Bataille_Tests is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Bataille_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("test_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use Bataille_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Bataille_Tests;
