with "config/bataille_config.gpr";

project Bataille is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Bataille_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("bataille.adb");

   package Compiler is
      for Default_Switches ("Ada") use Bataille_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  symbolic tracebacks
   end Binder;
end Bataille;
