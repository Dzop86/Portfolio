<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rpg.Core</RootNamespace>
  </PropertyGroup>
  <!-- The game's data, built in: data/spells.json, data/maps/*.json, data/scenarios/*.json. -->
  <ItemGroup>
    <EmbeddedResource Include="../../data/**/*.json" LogicalName="data/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rpg.Core.Tests" />
  </ItemGroup>
</Project>
