; Godot 4.7 project of the tactical RPG's desktop client. The rules come from ../src/Rpg.Core,
; the player's controls from ../src/Rpg.Client; this project only draws them.

config_version=5

[application]

config/name="Rpg"
config/description="A turn-based tactical RPG on an isometric board."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Rpg.Godot"

[rendering]

; The compatibility renderer (OpenGL 3) runs on old graphics cards and in a virtual screen.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.121569, 0.121569, 0.121569, 1)
; Needed by the universal macOS build (Apple Silicon).
textures/vram_compression/import_etc2_astc=true
