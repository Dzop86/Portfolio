{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osmose",
  "version": "0.1.0",
  "identifier": "io.github.dzop86.rpg-launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Osmose",
        "width": 520,
        "height": 720,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Launcher of Osmose, a tactical RPG",
    "publisher": "Osmose Team",
    "copyright": "© 2026 Osmose Team"
  }
}
